{
  "name": "kinetic-cursor",
  "version": "0.1.0",
  "description": "Physics-driven custom cursors for React.",
  "keywords": [
    "cursor",
    "react",
    "animation",
    "spring",
    "physics",
    "pointer"
  ],
  "license": "MIT",
  "author": "Isaac Allard (https://github.com/Arylite)",
  "homepage": "https://github.com/Arylite/kinetic-cursor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arylite/kinetic-cursor.git"
  },
  "bugs": "https://github.com/Arylite/kinetic-cursor/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "vite playground",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "prettier --check . && eslint . && tsc --noEmit && vitest run",
    "check:package": "publint && attw --pack --profile esm-only"
  },
  "packageManager": "pnpm@12.16.1",
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
